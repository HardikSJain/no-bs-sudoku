  "fixed_sql": [
    {
      "name": "puzzle_records",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"puzzle_records\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"puzzle_id\" TEXT NOT NULL, \"difficulty\" TEXT NOT NULL, \"is_daily\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_daily\" IN (0, 1)), \"time_seconds\" INTEGER NOT NULL, \"hints_used\" INTEGER NOT NULL DEFAULT 0, \"mistakes\" INTEGER NOT NULL DEFAULT 0, \"completed_at\" INTEGER NOT NULL, \"solve_times\" TEXT NOT NULL DEFAULT '', \"undos_used\" INTEGER NOT NULL DEFAULT 0, \"used_notes\" INTEGER NOT NULL DEFAULT 0 CHECK (\"used_notes\" IN (0, 1)), \"longest_pause_seconds\" INTEGER NOT NULL DEFAULT 0, \"mistake_cells\" TEXT NOT NULL DEFAULT '', \"quality_score\" REAL NOT NULL DEFAULT 0.0, \"formula_version\" INTEGER NOT NULL DEFAULT 1);"
        }
      ]
    },
    {
      "name": "player_profiles",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"player_profiles\" (\"id\" INTEGER NOT NULL DEFAULT 1, \"display_name\" TEXT NOT NULL DEFAULT 'anon', \"current_streak\" INTEGER NOT NULL DEFAULT 0, \"longest_streak\" INTEGER NOT NULL DEFAULT 0, \"last_played_date\" INTEGER NULL, \"total_solved\" INTEGER NOT NULL DEFAULT 0, \"total_started\" INTEGER NOT NULL DEFAULT 0, \"preferred_difficulty\" TEXT NOT NULL DEFAULT 'medium', \"last_freeze_used_date\" INTEGER NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "game_preferences_table",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"game_preferences_table\" (\"id\" INTEGER NOT NULL DEFAULT 1, \"auto_remove_notes\" INTEGER NOT NULL DEFAULT 1 CHECK (\"auto_remove_notes\" IN (0, 1)), \"highlight_matching\" INTEGER NOT NULL DEFAULT 1 CHECK (\"highlight_matching\" IN (0, 1)), \"show_timer\" INTEGER NOT NULL DEFAULT 0 CHECK (\"show_timer\" IN (0, 1)), \"mistake_limit\" INTEGER NOT NULL DEFAULT 0, \"theme\" TEXT NOT NULL DEFAULT 'paper', \"digit_first_input\" INTEGER NOT NULL DEFAULT 0 CHECK (\"digit_first_input\" IN (0, 1)), \"has_seen_onboarding\" INTEGER NOT NULL DEFAULT 0 CHECK (\"has_seen_onboarding\" IN (0, 1)), PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "daily_puzzle_cache",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"daily_puzzle_cache\" (\"key\" TEXT NOT NULL, \"clues\" TEXT NOT NULL, \"solution\" TEXT NOT NULL, \"difficulty\" TEXT NOT NULL, \"cached_at\" INTEGER NOT NULL, PRIMARY KEY (\"key\"));"
        }
      ]
    },
    {
      "name": "saved_games",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"saved_games\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"puzzle_id\" TEXT NOT NULL, \"difficulty\" TEXT NOT NULL, \"is_daily\" INTEGER NOT NULL CHECK (\"is_daily\" IN (0, 1)), \"given_cells\" TEXT NOT NULL, \"solution_cells\" TEXT NOT NULL, \"board_cells\" TEXT NOT NULL, \"notes\" TEXT NOT NULL, \"elapsed_seconds\" INTEGER NOT NULL, \"hints_remaining\" INTEGER NOT NULL, \"mistake_count\" INTEGER NOT NULL, \"is_notes_mode\" INTEGER NOT NULL CHECK (\"is_notes_mode\" IN (0, 1)), \"saved_at\" INTEGER NOT NULL);"
        }
      ]
    },
    {
      "name": "sync_queue_items",
      "sql": [
